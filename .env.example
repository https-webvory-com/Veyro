# Merchant OpenAI keys and models are configured inside Veyro > AI settings.

# The worker needs the same Shopify app credentials and database as the web app.
# Set real values in your local .env or deployment secrets; never commit them.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=

# Optional Google integrations (enable the corresponding APIs in Google Cloud).
PAGESPEED_API_KEY=
# One-line service account JSON. Grant client_email access to the store's
# exact https://primary-domain/ URL-prefix property in Google Search Console.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Google client IDs and secrets for GA4, Google Ads, and GTM are saved per store in Veyro > Integrations.

# PostgreSQL connection string (required by the web app, worker, and migrations).
DATABASE_URL=postgresql://veyro:CHANGE_ME@localhost:5432/veyro?schema=public
